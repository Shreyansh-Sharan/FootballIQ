# Copy to .env (git-ignored) and fill in. Never commit real values.

# --- Microsoft Fabric (service principal, client-credentials flow) ---
FABRIC_TENANT_ID=
FABRIC_CLIENT_ID=
FABRIC_CLIENT_SECRET=
FABRIC_WORKSPACE_NAME="Football Analytics Shreyansh"
FABRIC_WORKSPACE_ID=            # optional; overrides the name lookup
FABRIC_FOLDER_NAME=FootballIQ
FABRIC_LAKEHOUSE_NAME=lh_football_intelligence

# --- Backend ---
FOOTBALLIQ_SOURCE=fabric        # fabric = read the lakehouse (system of record); local = data/silver files
FABRIC_LAKEHOUSE_ID=            # optional; overrides the lakehouse name lookup
FOOTBALLIQ_PRELOAD=2022-12-18_argentina_france   # matches warmed into memory at startup (comma list)
FOOTBALLIQ_MATCHES=2022-12-18_argentina_france   # matches the app offers (comma list); empty = the whole catalogue
FOOTBALLIQ_CACHE_MATCHES=4      # in-memory LRU size (a match with tracking is roughly 150 MB)
FOOTBALLIQ_DATA_DIR=./data
FOOTBALLIQ_CORS_ORIGINS=http://localhost:3000

# --- Real-time path (P2): API -> Eventstream -> Eventhouse ---
FOOTBALLIQ_EVENTSTREAM=on                        # off = do not publish
FABRIC_EVENTSTREAM_NAME=es_football_replay       # connection resolved via the Fabric API (no key stored)
FABRIC_EVENTSTREAM_SOURCE=replay-api
FABRIC_EVENTHOUSE_NAME=eh_football_rt
# FOOTBALLIQ_EVENTSTREAM_CONNECTION=             # optional explicit Event Hubs connection string (secret)

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Microsoft Foundry agents (P5): Match Strategist + Moment Explainer ---
# Entra ID client credentials (role: Foundry User on the AI services resource). Token scope https://ai.azure.com/.default
FOUNDRY_PROJECT_ENDPOINT=https://ai-pai.services.ai.azure.com/api/projects/proj-default
FOUNDRY_TENANT_ID=
FOUNDRY_CLIENT_ID=
FOUNDRY_CLIENT_SECRET=
FOUNDRY_API_VERSION=2025-05-01
FOUNDRY_MODEL=gpt-5.1           # model deployment the agents run on
# FOUNDRY_AGENT_STRATEGIST_ID=  # optional: agents are found by name (footballiq-match-strategist / footballiq-moment-explainer)
# FOUNDRY_AGENT_EXPLAINER_ID=
# One-time / after changing instructions:  footballiq-agents setup   (idempotent; prints the agent ids)

# --- Later sprints ---
# PFF_USERNAME=
# PFF_PASSWORD=
